# Static hosting for the Orbis atlas (a Vite build in /srv).
{
	admin off
	auto_https off
	# Railway terminates TLS at its edge and forwards the real client address.
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Vite's content-hashed bundles never change under the same name.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Soundtracks and textures are large and rarely change.
	@media path /music/* /textures/*
	header @media Cache-Control "public, max-age=604800"

	# The atlas data and the page itself must pick up a new deploy right away.
	@fresh path / /index.html /data/*
	header @fresh Cache-Control "no-cache"

	# There are no client-side routes: a missing file is a real 404, never index.html
	# (an HTML fallback for data/atlas.json shows up as "the atlas could not be loaded").
	file_server

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
